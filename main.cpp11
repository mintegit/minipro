#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    char names[5][20];
    int marks[5][3];
    int total[5];
    double avg[5];

    for (int i = 0; i < 5; i++) {
        cout << "\nStudent " << i + 1 << " name: ";
        cin.getline(names[i], 20);

        for (int j = 0; j < 3; j++) {
            while (true) {
                cout << "  Enter mark " << j + 1 << " (0-100): ";
                if (cin >> marks[i][j] && marks[i][j] >= 0 && marks[i][j] <= 100) {
                    break; 
                }
                cout << "  Invalid mark! Please re-enter a value between 0 and 100.\n";
                cin.clear();      
                cin.ignore(numeric_limits<streamsize>::max(), '\n'); 
            }
        }
       cin.ignore(numeric_limits<streamsize>::max(), '\n');  // clear newline before next getline
    }

    for (int i = 0; i < 5; i++) {
        total[i] = 0;
        for (int j = 0; j < 3; j++) {
            total[i] += marks[i][j];
        }
        avg[i] = total[i] / (double)3;
    }

    
    cout << "\n" << left << setw(15) << "Name"
         << right << setw(6) << "M1" << setw(6) << "M2" << setw(6) << "M3"
         << setw(8) << "Total" << setw(8) << "Avg" << endl;
    cout << string(49, '-') << endl;

    cout << fixed << setprecision(1);
    for (int i = 0; i < 5; i++) {
        cout << left << setw(15) << names[i] << right;
        for (int j = 0; j < 3; j++) {
            cout << setw(6) << marks[i][j];
        }
        cout << setw(8) << total[i] << setw(8) << avg[i] << endl;
    }

    
    int top = 0;
    for (int i = 1; i < 5; i++) {
        if (total[i] > total[top]) top = i;
    }
    cout << "\nTop student: " << names[top] << endl;

    return 0;
}
    
